        <mxCell id="exp" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=17;spacingTop=12;spacingBottom=12;strokeWidth=1.7;" value="&lt;div style=&quot;text-align:left;line-height:1.32&quot;&gt;&lt;div style=&quot;font-size:18px;font-weight:700;margin-bottom:9px&quot;&gt;Tiempo de exposición (shutter speed)&lt;/div&gt;&lt;div style=&quot;font-size:15px&quot;&gt;Tiempo durante el cual el sensor recibe luz.&lt;br&gt;Si se acorta, reduce el desenfoque por movimiento y capta menos luz.&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="175" width="450" x="100" y="440" as="geometry" />
        </mxCell>
        <mxCell id="shutter" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=17;spacingTop=12;spacingBottom=12;strokeWidth=1.7;" value="&lt;div style=&quot;text-align:left;line-height:1.32&quot;&gt;&lt;div style=&quot;font-size:18px;font-weight:700;margin-bottom:9px&quot;&gt;Obturador global vs. rodante&lt;/div&gt;&lt;div style=&quot;font-size:15px&quot;&gt;Global: expone todos los píxeles al mismo tiempo.&lt;br&gt;Rodante: expone por filas; el movimiento puede deformar la imagen.&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="175" width="450" x="100" y="705" as="geometry" />
        </mxCell>
        <mxCell id="res" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=17;spacingTop=12;spacingBottom=12;strokeWidth=1.7;" value="&lt;div style=&quot;text-align:left;line-height:1.32&quot;&gt;&lt;div style=&quot;font-size:18px;font-weight:700;margin-bottom:9px&quot;&gt;Resolución vs. fps&lt;/div&gt;&lt;div style=&quot;font-size:15px&quot;&gt;Resolución: píxeles por imagen.&lt;br&gt;fps: imágenes capturadas por segundo.&lt;br&gt;Más resolución puede limitar los fps alcanzables.&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="155" width="450" x="675" y="425" as="geometry" />
        </mxCell>
        <mxCell id="bw" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=17;spacingTop=12;spacingBottom=12;strokeWidth=1.7;" value="&lt;div style=&quot;text-align:left;line-height:1.32&quot;&gt;&lt;div style=&quot;font-size:18px;font-weight:700;margin-bottom:9px&quot;&gt;Ancho de banda de la interfaz&lt;/div&gt;&lt;div style=&quot;font-size:15px&quot;&gt;Capacidad de transferir datos de la cámara.&lt;br&gt;Más píxeles, bits por píxel o fps requieren más ancho de banda.&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="155" width="450" x="675" y="635" as="geometry" />
        </mxCell>
        <mxCell id="lat" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=17;spacingTop=12;spacingBottom=12;strokeWidth=1.7;" value="&lt;div style=&quot;text-align:left;line-height:1.32&quot;&gt;&lt;div style=&quot;font-size:18px;font-weight:700;margin-bottom:9px&quot;&gt;Latencia vs. framerate&lt;/div&gt;&lt;div style=&quot;font-size:15px&quot;&gt;Latencia: demora desde la captura hasta disponer de la imagen.&lt;br&gt;Framerate: fotogramas por segundo (fps).&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="125" width="450" x="675" y="835" as="geometry" />
        </mxCell>
        <mxCell id="trig" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=17;spacingTop=12;spacingBottom=12;strokeWidth=1.7;" value="&lt;div style=&quot;text-align:left;line-height:1.32&quot;&gt;&lt;div style=&quot;font-size:18px;font-weight:700;margin-bottom:9px&quot;&gt;Sincronización / disparo (triggering)&lt;/div&gt;&lt;div style=&quot;font-size:15px&quot;&gt;Una señal inicia la exposición en un instante definido; permite coordinar cámara y evento.&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="175" width="450" x="1250" y="440" as="geometry" />
        </mxCell>
        <mxCell id="strobe" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=17;spacingTop=12;spacingBottom=12;strokeWidth=1.7;" value="&lt;div style=&quot;text-align:left;line-height:1.32&quot;&gt;&lt;div style=&quot;font-size:18px;font-weight:700;margin-bottom:9px&quot;&gt;Iluminación estroboscópica sincronizada&lt;/div&gt;&lt;div style=&quot;font-size:15px&quot;&gt;Un pulso breve de luz coincide con la exposición; ayuda a congelar objetos en movimiento.&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="175" width="450" x="1250" y="705" as="geometry" />
