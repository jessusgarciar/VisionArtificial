        <mxCell id="h3" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=15;strokeWidth=2;" value="&lt;div style=&quot;font-size:20px;font-weight:700&quot;&gt;Sincronización&lt;/div&gt;" vertex="1">
